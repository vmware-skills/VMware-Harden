{
  "manifest_version": "0.4",
  "name": "vmware-harden",
  "display_name": "VMware Harden",
  "version": "1.20.1",
  "description": "AI-native VMware compliance and baseline enforcement",
  "long_description": "Runs the published vmware-harden 1.20.1 MCP server locally. Follow the setup guide for local state and the sibling skills it uses.",
  "author": {
    "name": "Wei Zhou",
    "url": "https://github.com/zw008"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vmware-skills/VMware-Harden"
  },
  "homepage": "https://github.com/vmware-skills/VMware-Harden",
  "documentation": "https://github.com/vmware-skills/VMware-Harden/blob/main/skills/vmware-harden/references/setup-guide.md",
  "support": "https://github.com/vmware-skills/VMware-Harden/issues",
  "icon": "icon.png",
  "server": {
    "type": "uv",
    "entry_point": "server/main.py",
    "mcp_config": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${__dirname}",
        "server/main.py"
      ]
    }
  },
  "tools_generated": true,
  "keywords": [
    "vmware",
    "vsphere",
    "compliance",
    "baseline",
    "hardening"
  ],
  "license": "MIT",
  "compatibility": {
    "platforms": [
      "darwin",
      "win32",
      "linux"
    ],
    "runtimes": {
      "python": ">=3.10"
    }
  }
}
